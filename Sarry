RunService.RenderStepped:Connect(function()
    if not FlyEnabled or not FlyVelocity or not RootPart then
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local move = Humanoid and Humanoid.MoveDirection or Vector3.zero
    local vertical = 0

    if UIS:IsKeyDown(Enum.KeyCode.Space) or FlyUp then
        vertical += 1
    end

    if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
        or UIS:IsKeyDown(Enum.KeyCode.C)
        or FlyDown then
        vertical -= 1
    end

    FlyVelocity.Velocity =
        move * FlySpeed + Vector3.new(0, vertical * FlySpeed, 0)

    if FlyGyro then
        FlyGyro.CFrame = camera.CFrame
    end
end)

