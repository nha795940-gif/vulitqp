--==================================================
-- WALK SPEED
--==================================================

local function SetWalkSpeed(value)
    WalkSpeedValue = math.clamp(
        math.floor(tonumber(value) or 100),
        SPEED_MIN,
        SPEED_MAX
    )

    if SpeedEnabled and Humanoid then
        Humanoid.WalkSpeed = WalkSpeedValue
    end
end

local function ToggleSpeed(state)
    SpeedEnabled = state

    if not Humanoid then
        GetCharacter()
    end

    if SpeedEnabled then
        OriginalWalkSpeed = Humanoid.WalkSpeed
        Humanoid.WalkSpeed = WalkSpeedValue
    else
        Humanoid.WalkSpeed = OriginalWalkSpeed
    end
end

--==================================================
-- FLY SYSTEM
--==================================================

local FlyVelocity
local FlyGyro
local FlyConnection

local function StopFly()
    FlyEnabled = false

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end

    if Humanoid then
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function StartFly()
    if not Character or not Humanoid or not RootPart then
        GetCharacter()
    end

    StopFly()
    FlyEnabled = true

    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.Name = "VULITQHUB_FlyVelocity"
    FlyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    FlyVelocity.P = 1e5
    FlyVelocity.Velocity = Vector3.zero
    FlyVelocity.Parent = RootPart

    FlyGyro = Instance.new("BodyGyro")
    FlyGyro.Name = "VULITQHUB_FlyGyro"
    FlyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    FlyGyro.P = 1e5
    FlyGyro.CFrame = RootPart.CFrame
    FlyGyro.Parent = RootPart

    Humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not FlyEnabled or not RootPart or not Humanoid then
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then return end

        -- WASD / mobile joystick direction
        local moveDirection = Humanoid.MoveDirection

        -- Vertical movement
        local vertical = 0

        if VerticalUp then
            vertical += 1
        end

        if VerticalDown then
            vertical -= 1
        end

        -- PC vertical controls
        local lookDirection = camera.CFrame.LookVector
        local rightDirection = camera.CFrame.RightVector

        local direction = moveDirection

        if direction.Magnitude > 1 then
            direction = direction.Unit
        end

        direction = direction + Vector3.new(0, vertical, 0)

        if direction.Magnitude > 1 then
            direction = direction.Unit
        end

        FlyVelocity.Velocity = direction * FlySpeed

        -- Face camera direction horizontally
        local flatLook = Vector3.new(
            lookDirection.X,
            0,
            lookDirection.Z
        )

        if flatLook.Magnitude > 0.01 then
            FlyGyro.CFrame = CFrame.lookAt(
                RootPart.Position,
                RootPart.Position + flatLook
            )
        end
    end)
end

local function ToggleFly(state)
    if state then
        StartFly()
    else
        StopFly()
    end
end

--==================================================
-- KEYBOARD CONTROLS
