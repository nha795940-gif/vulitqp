-- KEY VERIFICATION
--==================================================

local verified = false

local function CheckKey()
    if verified then return end

    if KeyBox.Text == KEY then
        verified = true

        KeyStatus.TextColor3 = C.GREEN
        KeyStatus.Text = "Key correct!"

        task.wait(0.5)

        Tween(Intro,0.35,{
            BackgroundTransparency = 1
        })

        task.wait(0.35)

        Intro:Destroy()
        Main.Visible = true

        print("VulitqpHUB V2.0 loaded!")
    else
        KeyStatus.TextColor3 = C.RED
        KeyStatus.Text = "Wrong Key! Try again."

        KeyBox.Text = ""

        Tween(Intro,0.08,{
            Position = UDim2.fromScale(0.49,0.5)
        })

        task.wait(0.08)

        Tween(Intro,0.08,{
            Position = UDim2.fromScale(0.51,0.5)
        })

        task.wait(0.08)

        Tween(Intro,0.08,{
            Position = UDim2.fromScale(0.5,0.5)
        })
    end
end

Verify.MouseButton1Click:Connect(CheckKey)

KeyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        CheckKey()
    end
end)

