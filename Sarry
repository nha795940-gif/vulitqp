    button.Size = size
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(45, 39, 70)
    button.Text = text
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.AutoButtonColor = true
    button.Parent = parent
    Corner(button, 8)
    return button
end

local function NewFrame(parent, size, position, color)
    local frame = Instance.new("Frame")
    frame.Size = size
    frame.Position = position
    frame.BackgroundColor3 = color
    frame.BorderSizePixel = 0
    frame.Parent = parent
    Corner(frame, 12)
    return frame
end

