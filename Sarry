--==================================================
-- SPEED VALUE UPDATE
--==================================================

local function SetSpeed(value)
    FlySpeed = math.clamp(
        math.floor(value + 0.5),
        1,
        10000
    )

    local alpha = (FlySpeed - 1) / 9999

    SpeedInput.Text = tostring(FlySpeed)
    SpeedFill.Size = UDim2.new(alpha,0,1,0)
    SpeedDot.Position = UDim2.new(alpha,0,0.5,0)
if SpeedEnabled and Humanoid then
        Humanoid.WalkSpeed = FlySpeed
    end
end

SpeedInput.FocusLost:Connect(function()
    local value = tonumber(SpeedInput.Text)

    if value then
        SetSpeed(value)
    else
        SetSpeed(FlySpeed)
    end
end)

--==================================================
-- SLIDER INPUT
--==================================================

local sliding = false

local function SetSpeedFromX(x)
    local width = SpeedBar.AbsoluteSize.X

    if width <= 0 then return end

    local percent = math.clamp(
        (x-SpeedBar.AbsolutePosition.X)/width,
        0,
        1
    )

    SetSpeed(1 + percent * 9999)
end

SpeedBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        sliding = true
        SetSpeedFromX(input.Position.X)
    end
end)

UIS.InputChanged:Connect(function(input)
    if sliding and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        SetSpeedFromX(input.Position.X)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)

