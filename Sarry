local function StopFly()
    FlyEnabled = false
    FlyUp = false
    FlyDown = false

    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end

    if Humanoid then
        Humanoid.PlatformStand = false
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    if FlyToggleButton then
        FlyToggleButton.Text = "FLY: OFF"
        FlyToggleButton.BackgroundColor3 = CARD
    end
end

local function StartFly()
    if not RootPart or not Humanoid then
        return
    end

    FlyEnabled = true
    FlyToggleButton.Text = "FLY: ON"
    FlyToggleButton.BackgroundColor3 = DARK_PURPLE

    Humanoid.PlatformStand = true

    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    FlyVelocity.P = 1e5
    FlyVelocity.Velocity = Vector3.zero
    FlyVelocity.Parent = RootPart

    FlyGyro = Instance.new("BodyGyro")
    FlyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    FlyGyro.P = 1e5
    FlyGyro.CFrame = RootPart.CFrame
    FlyGyro.Parent = RootPart
end

FlyToggleButton.MouseButton1Click:Connect(function()
    if FlyEnabled then
        StopFly()
    else
        StartFly()
    end
end)

FlyUpButton.MouseButton1Down:Connect(function()
    FlyUp = true
end)

FlyUpButton.MouseButton1Up:Connect(function()
    FlyUp = false
end)

FlyDownButton.MouseButton1Down:Connect(function()
    FlyDown = true
end)

FlyDownButton.MouseButton1Up:Connect(function()
    FlyDown = false
end)

FlySpeedInput.FocusLost:Connect(function()
    local value = tonumber(FlySpeedInput.Text)

    if value then
        FlySpeed = math.clamp(math.floor(value), 1, 1000)
    end

    FlySpeedInput.Text = tostring(FlySpeed)
end)

RunService.RenderStepped:Connect(function()
    if not FlyEnabled or not FlyVelocity or not RootPart then
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local move = Humanoid and Humanoid.MoveDirection or Vector3.zero
    local vertical = 0

    if UIS:IsKeyDown(Enum.KeyCode.Space) or FlyUp then
        vertical += 1
    end

    if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
        or UIS:IsKeyDown(Enum.KeyCode.C)
        or FlyDown then
        vertical -= 1
    end

    FlyVelocity.Velocity =
        move * FlySpeed + Vector3.new(0, vertical * FlySpeed, 0)

    if FlyGyro then
        FlyGyro.CFrame = camera.CFrame
    end
end)

