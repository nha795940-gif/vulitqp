local function SetSpeed(value)
    WalkSpeedValue = math.clamp(
        math.floor(tonumber(value) or 50),
        1,
        1000
    )

    SpeedInput.Text = tostring(WalkSpeedValue)

    local percent = WalkSpeedValue / 1000

    SpeedFill.Size = UDim2.new(percent, 0, 1, 0)
    SpeedKnob.Position = UDim2.new(percent, -8, 0.5, -8)

    if SpeedEnabled and Humanoid then
        Humanoid.WalkSpeed = WalkSpeedValue
    end
end

SpeedInput.FocusLost:Connect(function()
    local value = tonumber(SpeedInput.Text)

    if value then
        SetSpeed(value)
    else
        SpeedInput.Text = tostring(WalkSpeedValue)
    end
end)

local SpeedSliding = false

local function UpdateSpeedSlider(x)
    local percent = math.clamp(
        (x - SpeedBar.AbsolutePosition.X) /
        SpeedBar.AbsoluteSize.X,
        0,
        1
    )

    SetSpeed(1 + percent * 999)
end

SpeedBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        SpeedSliding = true
        UpdateSpeedSlider(input.Position.X)
    end
end)

UIS.InputChanged:Connect(function(input)
    if SpeedSliding and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        UpdateSpeedSlider(input.Position.X)
    end
end)

UIS.InputEnded:Connect(function(input)
