        Font = Enum.Font.GothamMedium,
        LayoutOrder = i
    }, Sidebar)

    Round(Button, 9)
    TabButtons[i] = Button

    Button.MouseButton1Click:Connect(function()
        Heading.Text = name

        Home.Visible = i == 1
        PageInfo.Visible = i ~= 1

        if i ~= 1 then
            PageText.Text = name ..
                "\n\nChức năng đang được cập nhật"
        end

        for j, b in ipairs(TabButtons) do
            b.BackgroundColor3 = j == i
                and Color3.fromRGB(70, 25, 110)
                or PANEL
        end

        Content.CanvasPosition = Vector2.new(0, 0)
    end)
end

