local function New(class,props,parent)
    local obj = Instance.new(class)
    for k,v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function Round(obj,r)
    New("UICorner",{
        CornerRadius = UDim.new(0,r)
    },obj)
end

local function Stroke(obj)
    New("UIStroke",{
        Color = PURPLE,
        Thickness = 1.2,
        Transparency = 0.2
    },obj)
end

