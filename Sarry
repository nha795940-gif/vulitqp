            and Color3.fromRGB(70, 25, 110)
            or Panel,
        Text = name,
        TextColor3 = White,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextWrapped = true
    }, Sidebar)

    Round(Button, 10)
    TabButtons[i] = Button

    Button.MouseButton1Click:Connect(function()
        Heading.Text = name

        for j, b in ipairs(TabButtons) do
            b.BackgroundColor3 = j == i
                and Color3.fromRGB(70, 25, 110)
                or Panel
        end

        Home.Visible = i == 1
        Placeholder.Visible = i ~= 1

        if i ~= 1 then
            Placeholder.Text = name .. "\nChức năng đang được cập nhật"
        end
    end)
end

