    --==============================================

    local candy, candyPosition =
        findClosestCandy(root)

    if candy and candyPosition then

        setStatus("Collecting candy...")

        root.CFrame = CFrame.new(
            candyPosition + Vector3.new(0, 4, 0)
        )

        humanoid.Jump = true

        humanoid:ChangeState(
            Enum.HumanoidStateType.Jumping
        )

        continue
    end

    --==============================================
    -- PRIORITY 2: DOOR
    --==============================================

    local currentTime = os.clock()

    if currentTime - LastDoorTime >= DoorCooldown then

        local prompt, part = findClosestDoor(root)

        if prompt and part then

            setStatus("Visiting closest door...")

            humanoid.Jump = true

            humanoid:ChangeState(
                Enum.HumanoidStateType.Jumping
            )

            root.CFrame = part.CFrame

            if typeof(fireproximityprompt) == "function" then

                fireproximityprompt(prompt)

            end

            LastDoorTime = currentTime

        else

            setStatus("No candy - No doors found")

        end
    end

end
    
end) 
 
