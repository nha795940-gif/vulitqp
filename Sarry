--==================================================
-- GET CANDY POSITION
--==================================================

local function getCandyPosition(candy)

    local rest = candy:GetAttribute("Rest")

    if typeof(rest) == "CFrame" then
        return rest.Position
    end

    if typeof(rest) == "Vector3" then
        return rest
    end

    if candy:IsA("BasePart") then
        return candy.Position
    end

    if candy:IsA("Model") then
        return candy:GetPivot().Position
    end

    local part = candy:FindFirstChildWhichIsA(
        "BasePart",
        true
    )

    if part then
        return part.Position
    end

    return nil
end

--==================================================
-- FIND CLOSEST CANDY
--==================================================

local function findClosestCandy(root)

    local closestCandy
    local closestPosition
    local closestDistance = math.huge

    for _, candy in ipairs(folder:GetChildren()) do

        local position = getCandyPosition(candy)

        if position then

            local distance =
                (root.Position - position).Magnitude

            if distance < closestDistance then

                closestDistance = distance
                closestCandy = candy
                closestPosition = position

            end

        end
    end

    return closestCandy, closestPosition
end

--==================================================
-- CHECK BUSY
--==================================================

local function isBusy(character)

    return character:FindFirstChild("RootAnchor")
        or character:FindFirstChild("NoRotate")

end

--==================================================
-- FIND CLOSEST DOOR
--==================================================

local function findClosestDoor(root)

    local closestPrompt
    local closestPart
    local closestDistance = math.huge

    for _, tree in ipairs(trees:GetChildren()) do

        local door = tree:FindFirstChild("DOOR 1 NEW")
        local frame = door and door:FindFirstChild("Frame")

        local prompt = frame and
            frame:FindFirstChild("TrickOrTreat")

        if prompt and prompt:IsA("ProximityPrompt") then

            local part = prompt.Parent

            if part and part:IsA("BasePart") then

                local distance =
                    (root.Position - part.Position).Magnitude

                if distance < closestDistance then

                    closestDistance = distance
                    closestPrompt = prompt
                    closestPart = part

                end

            end
        end
    end

    return closestPrompt, closestPart
end

