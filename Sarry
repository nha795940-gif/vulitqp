    if value then
        SetSpeed(value)
    else
        SpeedInput.Text = tostring(WalkSpeedValue)
    end
end)

local SpeedSliding = false

local function UpdateSpeedSlider(x)
    local percent = math.clamp(
        (x - SpeedBar.AbsolutePosition.X) /
        SpeedBar.AbsoluteSize.X,
        0,
        1
    )

    SetSpeed(1 + percent * 999)
end

