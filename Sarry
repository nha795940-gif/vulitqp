local function New(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function Round(obj, radius)
    New("UICorner", {
        CornerRadius = UDim.new(0, radius)
    }, obj)
end

local function Border(obj)
    New("UIStroke", {
        Color = PURPLE,
        Thickness = 1.2,
        Transparency = 0.2
    }, obj)
end

