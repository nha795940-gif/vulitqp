local function New(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function Corner(obj, radius)
    New("UICorner", {
        CornerRadius = UDim.new(0,radius)
    },obj)
end

local function Outline(obj)
    New("UIStroke", {
        Color = C.PURPLE,
        Thickness = 1.3,
        Transparency = 0.1
    },obj)
end

