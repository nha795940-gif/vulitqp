local TabButtons = {}

for i, name in ipairs(Tabs) do
    local Button = New("TextButton", {
        Position = UDim2.new(0.07, 0, 0, 18 + (i-1)*53),
        Size = UDim2.new(0.86, 0, 0, 43),
