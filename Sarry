local function GetTarget(obj)
    if obj:IsA("Model") then
        return obj
    elseif obj:IsA("BasePart") then
        return obj:FindFirstAncestorOfClass("Model") or obj
    end
end

local function AddHighlight(target, color, storage)
    if not target or storage[target] then return end

    local h = Instance.new("Highlight")
    h.Adornee = target
    h.FillTransparency = 1
    h.OutlineTransparency = 0
    h.OutlineColor = color
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = target

    storage[target] = h
end

local function ClearHighlights(storage)
    for target, h in pairs(storage) do
        if h then h:Destroy() end
    end

    table.clear(storage)
end

local ORANGE = Color3.fromRGB(255, 135, 25)
local YELLOW = Color3.fromRGB(255, 235, 0)

local function ScanDoors()
    local folder = workspace:FindFirstChild("HalloweenDoorTrees")

    if folder then
        for _, obj in ipairs(folder:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                AddHighlight(GetTarget(obj), ORANGE, DoorHighlights)
            end
        end
    end
end

local function ScanTeddy()
