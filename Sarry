local function CreateSlider(parent, title, minValue, maxValue, initial, callback)
    local holder = NewFrame(
        parent,
        UDim2.new(1, -4, 0, 90),
        UDim2.new(),
        Color3.fromRGB(30, 27, 44)
    )

    NewText(
        holder,
        title,
        UDim2.new(0.65, 0, 0, 30),
        UDim2.fromOffset(12, 5),
        13
    )

    local input = Instance.new("TextBox")
    input.Size = UDim2.fromOffset(75, 28)
    input.Position = UDim2.new(1, -87, 0, 5)
    input.BackgroundColor3 = Color3.fromRGB(50, 43, 70)
    input.TextColor3 = Color3.new(1, 1, 1)
    input.Font = Enum.Font.GothamBold
    input.TextSize = 13
    input.Text = tostring(initial)
    input.ClearTextOnFocus = false
    input.Parent = holder
    Corner(input, 7)

    local barBG = Instance.new("Frame")
    barBG.Size = UDim2.new(1, -24, 0, 9)
    barBG.Position = UDim2.fromOffset(12, 58)
    barBG.BackgroundColor3 = Color3.fromRGB(60, 54, 77)
    barBG.BorderSizePixel = 0
    barBG.Parent = holder
    Corner(barBG, 8)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(
        (initial - minValue) / (maxValue - minValue),
        0, 1, 0
    )
    fill.BackgroundColor3 = Color3.fromRGB(150, 95, 255)
    fill.BorderSizePixel = 0
    fill.Parent = barBG
    Corner(fill, 8)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(15, 15)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(230, 215, 255)
    knob.Parent = barBG
    Corner(knob, 20)

    local currentValue = initial

    local function SetValue(value)
        value = math.clamp(
            math.floor(tonumber(value) or initial),
            minValue,
            maxValue
        )

        currentValue = value
        input.Text = tostring(value)

        local percent = (value - minValue) / (maxValue - minValue)

        fill.Size = UDim2.new(percent, 0, 1, 0)
        knob.Position = UDim2.new(percent, 0, 0.5, 0)

        callback(value)
    end

    input.FocusLost:Connect(function()
        SetValue(input.Text)
    end)

    local sliding = false

    local function UpdateFromPosition(x)
        local width = barBG.AbsoluteSize.X
        if width <= 0 then return end

        local percent = math.clamp(
            (x - barBG.AbsolutePosition.X) / width,
            0,
            1
        )

        SetValue(minValue + percent * (maxValue - minValue))
    end

    barBG.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1
        or inputObject.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            UpdateFromPosition(inputObject.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(inputObject)
        if sliding and (
            inputObject.UserInputType == Enum.UserInputType.MouseMovement
            or inputObject.UserInputType == Enum.UserInputType.Touch
        ) then
            UpdateFromPosition(inputObject.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1
        or inputObject.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    SetValue(initial)

    return SetValue
end

